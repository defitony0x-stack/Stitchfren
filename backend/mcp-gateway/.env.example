# OKX ASP credentials — from registering as an Agent Service Provider
# (A2MCP mode) on OKX AI. Registration itself happens on OKX's side, not
# in this code.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Wallet that receives x402 settlement (X Layer / eip155:196)
PAY_TO_ADDRESS=

# Your deployed Stitchfren FastAPI backend (from the cutline/ repo)
STITCHFREN_API_BASE=https://your-app.up.railway.app

# A backend API key generated once via POST /api/keys/generate on that
# backend — this gateway uses it server-to-server for every job.
STITCHFREN_SERVICE_KEY=

# Optional — overrides the placeholder $0.50 price for /mcp/draft-and-nest
STITCHFREN_PRICE=$0.50

PORT=8402
