# --- Database ---
DATABASE_URL=postgresql://user:password@host:5432/stitchfren

# --- Celery / Redis (old REST API's async queue - unchanged) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Cloudflare R2 (optional - DXF storage across separate web/worker instances) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_PRESIGNED_EXPIRY_SECONDS=604800

# --- LLM (optional - free-text measurement parsing + cutting-sheet narrative) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- x402 / OKX A2MCP (new - gates the real /mcp tool in app/mcp/) ---
# Leaving any of these unset runs /mcp WITHOUT payment gating - fine for
# local testing, not for pointing OKX's A2MCP listing at this deploy.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
PAY_TO_ADDRESS=
# USD₮0 token contract address on X Layer (eip155:196) - confirm this is
# current before relying on it.
USDT0_ASSET_ADDRESS=
# $0.50 in atomic units, assuming 6 decimals like USDC/USDT - confirm
# USD₮0's actual decimals before trusting this conversion.
STITCHFREN_PRICE_ATOMIC=500000
